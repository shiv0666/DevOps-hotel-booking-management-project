# Backend Environment Variables
# Copy this to .env in the backend folder

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/hotel_booking_db
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/hotel_booking_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
TOKEN_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend Environment Variables
# Copy this to .env in the frontend folder

VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Hotel Booking System
